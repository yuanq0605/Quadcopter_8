  174 00000000         ; ★ 入口函数叫 asm_main，不叫 main —— 这�
                       ��有原因的，别改回去！
  175 00000000         ;
  176 00000000         ;   ARMCC/armlink 有一个"贴心"行为：只要映像
                       里存在名为 main 的符号，
  177 00000000         ;   链接器就会自动 "Adding startup reference: __m
                       ain"，把 C 库的
  178 00000000         ;   启动代码（__rt_entry / __scatterload / 半主�
                       � __user_initial_stackheap）
  179 00000000         ;   一起拉进来。而半主机版的 __user_initial_
                       stackheap 在 scatter 分散
  180 00000000         ;   加载模式下无法确定堆区，于是报：
  181 00000000         ;     L6915E: Library reports error: The semihosting
  182 00000000         ;     __user_initial_stackheap cannot reliably set up a 
                       usable heap
  183 00000000         ;     region if scatter loading is in use
  184 00000000         ;   这个行为与 --entry=Reset_Handler 无关（加�
                       �也一样），唯一的办法
  185 00000000         ;   就是不要用 main 这个名字。asmLight 那份�
                       ��程叫 asm_main 正是这个道理。
  186 00000000         ;-------------------------------------------------------
                       --------------
  187 00000000                 IMPORT           asm_main
  188 00000000         
  189 00000000         ; 下面 4 个是 armlink 按 scatter 文件里的区域
                       名自动生成的符号，
  190 00000000         ; 用来告诉我们各段在 Flash / SRAM 中的实际�
                       ��止地址。
  191 00000000         ; 官方默认 scatter（uVision "Use Memory Layout from
                        Target Dialog"）里
  192 00000000         ; 区域名就是 ER_IROM1 和 RW_IRAM1，与你 asmLigh
                       t 工程的 .sct 一致。
  193 00000000                 IMPORT           |Image$$ER_IROM1$$RO$$Limit| ; 
                                                            RO 段末尾 = .dat
                                                            a 初值在 Flash �
                                                            ��起始
  194 00000000                 IMPORT           |Image$$RW_IRAM1$$RW$$Base| ; .
                                                            data 在 SRAM 的�
                                                            �始
  195 00000000                 IMPORT           |Image$$RW_IRAM1$$ZI$$Base| ; .
                                                            bss(ZI) 起始（�
                                                            �是 .data 的结�
                                                            �）
  196 00000000                 IMPORT           |Image$$RW_IRAM1$$ZI$$Limit| 
                                                            ; .bss(ZI) 结束
