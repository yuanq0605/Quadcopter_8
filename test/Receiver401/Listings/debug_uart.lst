  103 00000000         ;  Debug_UART_Init —— PA2 复用为 USART2_TX，1152
                       00 / 8N1，只发不收
  104 00000000         ;
  105 00000000         ;  DS9716 P45 Table 9 "Alternate function mapping"：PA2
                        的 AF07 = USART2_TX
  106 00000000         ;
  107 00000000         ;  BRR：USART2 挂在 APB1，fCK = PCLK1 = 42MHz
  108 00000000         ;      USARTDIV = 42 000 000 / (16 × 115 200) = 22.786
  109 00000000         ;      BRR[15:4] = 22 = 0x16
  110 00000000         ;      BRR[3:0]  = 0.786 × 16 ≈ 13 = 0xD
  111 00000000         ;      → BRR = 0x16D   (实际 115068bps，误差 +0.0
                       6%)
  112 00000000         ;
  113 00000000         ;  ★ 注意：这里是唯一打开 GPIOA 时钟的地
                       方。
  114 00000000         ;    main.s 的 GPIO_Init 只开 GPIOC + DMA2，不碰 G
                       PIOA。
  115 00000000         ;=======================================================
                       ==============
