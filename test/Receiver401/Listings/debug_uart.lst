  119 00000002 6801            LDR              R1, [R0]
  120 00000004 F041 0101       ORR              R1, R1, #0x00000001 ; bit0  GPI
                                                            OAEN（RM0368 P118�
                                                            ��
  121 00000008 6001            STR              R1, [R0]
  122 0000000A         
  123 0000000A 485C            LDR              R0, =RCC_APB1ENR
  124 0000000C 6801            LDR              R1, [R0]
  125 0000000E F441 3100       ORR              R1, R1, #0x00020000 ; bit17 USA
                                                            RT2EN（RM0368 P120
                                                            ）
  126 00000012 6001            STR              R1, [R0]
